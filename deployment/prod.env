# ============================================================
# SLACK
# ============================================================
SLACK_WORKSPACE_ID=T01QQ0Q5GMA

# FEATURE FLAGS
# ============================================================
ENABLE_2PR=false

# ============================================================
# API CUSTOM DOMAIN
# ============================================================
API_CUSTOM_DOMAIN=oscar-prod.opensearch.org

# ============================================================
# JENKINS AGENT
# ============================================================
JENKINSFILE_IGNORE_LIST=jenkins/gradle,jenkins/legacy
JENKINS_URL=https://build.ci.opensearch.org
JENKINSFILE_GITHUB_REPO=opensearch-project/opensearch-build

# ============================================================
# GITHUB AGENT
# ============================================================
GITHUB_ORG=opensearch-project
# Comma-separated GitHub usernames allowed to merge auto PRs
ALLOWED_MERGE_AUTHORS=opensearch-ci-bot

# ============================================================
# METRICS AGENT
# ============================================================
# Metrics configuration is managed via GitHub environment
# variables

# ============================================================
# ADVISORIES AGENT
# ============================================================
REMEDIATION_BASE_OWNER=opensearch-project

# To be replaced with oscar-ci-bot
REMEDIATION_WRITE_OWNER=opensearch-ci-bot

# Commit author identity (DCO: Signed-off-by must match author).
REMEDIATION_GIT_NAME=opensearch-ci-bot
REMEDIATION_GIT_EMAIL=opensearch-infra@amazon.com