# ============================================================
# SLACK
# ============================================================
SLACK_WORKSPACE_ID=T01QQ0Q5GMA

# FEATURE FLAGS
# ============================================================
ENABLE_2PR=false

# ============================================================
# JENKINS AGENT
# ============================================================
JENKINSFILE_IGNORE_LIST=jenkins/gradle,jenkins/legacy
JENKINS_URL=https://build.ci.opensearch.org
JENKINSFILE_GITHUB_REPO=opensearch-project/opensearch-build

# ============================================================
# GITHUB AGENT
# ============================================================
GITHUB_ORG=opensearch-project
# Comma-separated GitHub usernames allowed to merge auto PRs
ALLOWED_MERGE_AUTHORS=opensearch-ci-bot

# ============================================================
# METRICS AGENT
# ============================================================
# Metrics configuration is managed via GitHub environment
# variables

# ============================================================
# CVE REMEDIATION
# ============================================================
# Fork the worker pushes fixes to / opens PRs against — the bot account's fork
# owner (bot account still TBD; see cve-remediation-deploy-prerequisites.md).
REMEDIATION_WRITE_OWNER=
# Secrets Manager secret NAMES only — the token VALUES are created manually in
# Secrets Manager (see the deploy runbook). One GitHub token serves both the
# read-side pre-flight and the worker's push/PR.
GH_TOKEN_SECRET_NAME=oscar-remediation-gh-token-prod
SLACK_BOT_TOKEN_SECRET_NAME=oscar-remediation-slack-token-prod
# Commit author identity for the bot (DCO requires Signed-off-by == author). TBD.
REMEDIATION_GIT_NAME=
REMEDIATION_GIT_EMAIL=
